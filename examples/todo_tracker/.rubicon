layers:
  presentation:
    directories:
      - ui/
    color: "#4CAF50"
  domain:
    directories:
      - services/
    color: "#2196F3"
  data:
    directories:
      - data/
    color: "#FF9800"
  foundation:
    directories:
      - models/
    color: "#9C27B0"

layer_order:
  - presentation
  - domain
  - data
  - foundation

foundation_layers:
  - foundation

rules:
  - no_upward_dependency
  - inheritance_flows_downward
  - no_layer_skipping
  - no_circular_ownership
  - no_circular_imports
  - dependency_inversion
  - single_responsibility
  - orphan_detection
