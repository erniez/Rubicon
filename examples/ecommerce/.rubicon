layers:
  presentation:
    directories:
      - ui/
    color: "#4A90D9"

  domain:
    directories:
      - services/
      - models/
    color: "#50C878"

  data:
    directories:
      - data/
    color: "#E8A838"

  networking:
    directories:
      - api/
    color: "#D94A4A"

  utilities:
    directories:
      - utils/
    color: "#9B59B6"

layer_order:
  - presentation
  - domain
  - data
  - [networking, utilities]

rules:
  - no_upward_dependency
  - no_layer_skipping
  - inheritance_flows_downward
  - no_circular_ownership
  - no_circular_imports
  - single_responsibility
  - orphan_detection
