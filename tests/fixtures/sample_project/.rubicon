layers:
  presentation:
    directories:
      - app/ui/
      - app/screens/
    color: "#4A90D9"

  domain:
    directories:
      - app/models/
      - app/usecases/
    color: "#50C878"

  data:
    directories:
      - app/database/
      - app/repository/
    color: "#E8A838"

  networking:
    directories:
      - app/api/
      - app/network/
    color: "#D94A4A"

rules:
  - no_upward_dependency
  - no_layer_skipping
  - inheritance_flows_downward
  - no_circular_ownership

layer_order:
  - presentation
  - domain
  - data
  - networking
